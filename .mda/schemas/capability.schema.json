{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "point",
    "name",
    "minimum_maturity",
    "default_state"
  ],
  "properties": {
    "id": {
      "pattern": "^P[0-9]{2}$"
    },
    "point": {
      "type": "integer",
      "minimum": 1,
      "maximum": 19
    },
    "name": {
      "type": "string"
    },
    "minimum_maturity": {
      "type": "string"
    },
    "default_state": {
      "enum": [
        "ABSENT",
        "DECLARED",
        "CONFIGURED",
        "ENABLED",
        "ENFORCED",
        "QUARANTINED",
        "DEPRECATED"
      ]
    }
  }
}
