{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project_state",
    "maturity",
    "governance_version"
  ],
  "properties": {
    "project_state": {
      "enum": [
        "GREENFIELD",
        "BROWNFIELD",
        "MIGRATING"
      ]
    },
    "maturity": {
      "type": "string"
    },
    "governance_version": {
      "type": "string"
    }
  }
}
