      "write_policy": "APPROVED_TASK",
      "forbid": [
        "secrets",
        "writes outside approved task scope",
        "implementation without governed task"
      ],
      "scope_class": "PRODUCT",
      "state": "DECLARED_UNMATERIALIZED",
      "intent_id": "INTENT-446E2407EF97",
      "intent_source": "intake/OBJECTIVE.md"
    },
    "reports": {
      "purpose": "Generated analytical reports and evidence.",
      "write_policy": "APPROVED_TASK",
      "forbid": [
        "secrets",
        "writes outside approved task scope",
        "implementation without governed task"
      ],
      "scope_class": "PRODUCT",
      "state": "DECLARED_UNMATERIALIZED",
      "intent_id": "INTENT-446E2407EF97",
      "intent_source": "intake/OBJECTIVE.md"
    },
    "test/product": {
      "purpose": "Product-level deterministic tests for data and model logic.",
      "write_policy": "APPROVED_TASK",
      "forbid": [
        "secrets",
        "writes outside approved task scope",
        "implementation without governed task"
      ],
      "scope_class": "PRODUCT",
      "state": "DECLARED_UNMATERIALIZED",
      "intent_id": "INTENT-446E2407EF97",
      "intent_source": "intake/OBJECTIVE.md"
    }
  }
}
