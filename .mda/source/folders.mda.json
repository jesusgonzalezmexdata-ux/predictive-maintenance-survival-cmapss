{
  "schema_version": "2.0.0",
  "folders": {
    ".agents": {
      "purpose": "Canonical agent roles, skills, context contracts and handoff semantics.",
      "write_policy": "OWNER_OR_GOVERNED_MATERIALIZER",
      "forbid": [
        "runtime secrets",
        "product implementation"
      ],
      "scope_class": "GOVERNANCE"
    },
    ".federated": {
      "purpose": "Point 17 privacy-preserving federation contracts and quarantined exchange areas.",
      "write_policy": "P17_REQUIRED",
      "forbid": [
        "raw source export",
        "PII",
        "secrets"
      ],
      "scope_class": "GOVERNANCE"
    },
    ".hooks": {
      "purpose": "Tool-agnostic event interception, Git gates and external enforcement adapters.",
      "write_policy": "GOVERNANCE_CHANGE",
      "forbid": [
        "silent bypasses",
        "self-disabling enforcement"
      ],
      "scope_class": "GOVERNANCE"
    },
    ".logs": {
      "purpose": "Append-only runtime evidence, reports, incidents, metrics and run artifacts.",
      "write_policy": "APPEND_OR_REPORT_ONLY",
      "forbid": [
        "normative policy"
      ],
      "scope_class": "GOVERNANCE"
    },
    ".mda": {
      "purpose": "Canonical Meta-Description Architecture source, schemas and adapter templates.",
      "write_policy": "OWNER_APPROVED_GOVERNANCE",
      "forbid": [
        "runtime secrets",
        "tool-specific source of truth outside templates"
      ],
      "scope_class": "GOVERNANCE"
    },
    ".sandbox": {
      "purpose": "Isolation profiles and reproducible execution environment declarations.",
      "write_policy": "GOVERNANCE_CHANGE",
      "forbid": [
        "host-wide privileges by default"
      ],
      "scope_class": "GOVERNANCE"
    },
    ".scripts": {
      "purpose": "repoctl enforcement kernel and cross-platform wrappers.",
      "write_policy": "GOVERNED_IMPLEMENTATION",
      "forbid": [
        "provider-specific business logic in core"
      ],
      "scope_class": "GOVERNANCE"
    },
    "config": {
      "purpose": "Repository routing, budgets, schedules, security and activation parameters.",
      "write_policy": "OWNER_OR_APPROVED_TASK",
      "forbid": [
        "API keys",
        "passwords",
        "unbounded spend"
      ],
      "scope_class": "GOVERNANCE"
    },
    "docs": {
      "purpose": "Architecture, ADRs, specs, tasks, incidents, proposals and operating documentation.",
      "write_policy": "GOVERNED_DOCUMENTATION",
      "forbid": [
        "secrets",
        "false canonical status"
      ],
      "scope_class": "GOVERNANCE"
    },
    "test": {
      "purpose": "Kernel tests, agent QA fixtures and benchmark definitions.",
      "write_policy": "GOVERNED_TESTING",
      "forbid": [
        "production credentials",
        "network dependence in unit tests"
      ],
      "scope_class": "GOVERNANCE"
    },
    "intake": {
      "purpose": "Owner-controlled Markdown intent inbox. Files here are normalized into contracts and architecture scaffolds; never direct product code.",
      "write_policy": "OWNER_INTENT_INPUT",
      "forbid": [
        "secrets",
        "production credentials",
        "automatic product implementation"
      ],
      "scope_class": "GOVERNANCE"
    },
    "src": {
      "purpose": "Reusable production-grade data science source.",
      "write_policy": "APPROVED_TASK",
      "forbid": [
        "secrets",
        "writes outside approved task scope",
        "implementation without governed task"
      ],
      "scope_class": "PRODUCT",
      "state": "DECLARED_UNMATERIALIZED",
      "intent_id": "INTENT-446E2407EF97",
      "intent_source": "intake/OBJECTIVE.md"
    },
    "data/raw": {
      "purpose": "Immutable or externally sourced raw data boundary; never commit sensitive datasets by default.",
      "write_policy": "APPROVED_TASK",
      "forbid": [
        "secrets",
        "writes outside approved task scope",
        "implementation without governed task"
      ],
      "scope_class": "PRODUCT",
      "state": "DECLARED_UNMATERIALIZED",
      "intent_id": "INTENT-446E2407EF97",
      "intent_source": "intake/OBJECTIVE.md"
    },
    "data/processed": {
      "purpose": "Derived datasets and deterministic processing outputs.",
      "write_policy": "APPROVED_TASK",
      "forbid": [
        "secrets",
