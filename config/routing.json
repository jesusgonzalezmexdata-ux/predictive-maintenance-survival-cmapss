{
  "schema_version": "1.0.0",
  "default": "LOCAL_SAFE",
  "routes": [
    {
      "class": "LOCAL_SAFE",
      "use_when": [
        "single-file",
        "docs",
        "atomic-tests",
        "low-risk"
      ],
      "requirements": [
        "bounded context",
        "manual or deterministic verification"
      ]
    },
    {
      "class": "FRONTIER",
      "use_when": [
        "architecture",
        "multi-file",
        "integration",
        "ambiguous-reasoning"
      ],
      "requirements": [
        "preflight",
        "scope guard",
        "full verification"
      ]
    },
    {
      "class": "HUMAN_ONLY",
      "use_when": [
        "governance-promotion",
        "production-release",
        "federated-publish",
        "spend-authorization"
      ],
      "requirements": [
        "explicit owner authority"
      ]
    }
  ]
}
