{
  "schema_version": "1.0.0",
  "protected_paths": [
    ".mda/source",
    ".hooks",
    "config/authority.json",
    ".github/workflows"
  ],
  "secret_patterns": [
    "-----BEGIN .*PRIVATE KEY-----",
    "AKIA[0-9A-Z]{16}",
    "(?i)(api[_-]?key|secret|token|password)\\s*[:=]\\s*[\\\"\\'][^\\\"\\']{8,}"
  ],
  "ignored_paths": [
    ".git",
    ".logs",
    "test/fixtures",
    ".venv"
  ],
  "ignored_paths_note": ".venv added under DEC-010 (HG-002=A): gitignored third-party site-packages produced false positives (PIL, pip, fontTools); repository content is still fully scanned.",
  "dependency_change_requires_review": true
}
